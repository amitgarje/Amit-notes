# =========================================================
# Amit's Notes Vault - Frontend Environment Variables
# Copy this file to .env and fill in your Firebase Web App credentials.
# Get these from: Firebase Console -> Project Settings -> General -> Your Apps
# =========================================================

VITE_FIREBASE_API_KEY=AIzaSyDemoDummyApiKeyForLocalTesting12345
VITE_FIREBASE_AUTH_DOMAIN=amits-notes-vault.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=amits-notes-vault
VITE_FIREBASE_STORAGE_BUCKET=amits-notes-vault.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Admin UID (Your Firebase Auth UID)
VITE_ADMIN_UID=
